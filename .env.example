# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost:8000
#
# For a demo you do not need this file at all: ./demo.sh writes a .env with
# generated secrets and this machine's LAN address, then builds, seeds and
# prints the logins. See docs/DEMO.md.
#
# Out of the box this is the LOCAL stack: real Postgres in a container,
# real gunicorn, real migrations, no TLS. Only SECRET_KEY and
# POSTGRES_PASSWORD have to be filled in below.
#
# Going to AWS later means three changes, no code: APP_ENV=production,
# DATABASE_URL pointed at RDS with sslmode=require, and RUN_MIGRATIONS=0
# with migrations applied in a pre-deploy step. See docs/AWS_READINESS.md.

# ── Required ──────────────────────────────────────────────────────────────────

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out. Every app instance must share the same value.
SECRET_KEY=

# Postgres password for the bundled db service.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Which environment this is. One of:
#
#   local        the whole stack on your machine. No TLS, mail to the log.
#   production   a real deployment. Requires TLS to the database, https in
#                BASE_URL and Secure cookies; refuses to boot without them.
#
# Nothing else silently overrides this — a typo is a boot failure, not a
# quiet downgrade to the relaxed settings.
APP_ENV=local

# Public origin, used to build the links inside verification and reset
# emails. Must be https:// when APP_ENV=production.
BASE_URL=http://localhost:8000

# Host port the app is published on locally.
APP_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ignite
POSTGRES_DB=ignite

# Set DATABASE_URL directly when using managed Postgres instead of the
# bundled db service (then delete that service from docker-compose.yml).
#
# sslmode is MANDATORY in production and the app refuses to boot without
# it: psycopg defaults to "prefer", which silently falls back to plaintext
# if the server allows it, and RDS allows it unless rds.force_ssl=1.
# DATABASE_URL=postgresql://user:pass@host:5432/ignite?sslmode=require

# How many proxies sit in front of the app. 1 for a bare load balancer, 2
# behind a CDN. Getting this wrong puts every user in one rate-limit
# bucket, so production refuses to boot with 0.
TRUSTED_PROXIES=1

# Apply migrations at container start-up. Turn this OFF in production and
# run them in a pre-deploy step instead: during a rolling deploy the first
# new task would otherwise migrate the schema out from under the old tasks
# still serving traffic. See docs/AWS_READINESS.md.
RUN_MIGRATIONS=1

# Connections used = WEB_CONCURRENCY * DB_POOL_MAX. Keep it under the
# server's max_connections (100 by default).
#
# 2 * 3 = 6 is the compose default, sized for a single small box — a
# Raspberry Pi running the app and the database together. On a real server
# 4 * 5 = 20 is a better starting point and still leaves room for psql,
# backups and a second instance during a deploy.
WEB_CONCURRENCY=2
DB_POOL_MAX=3

# ── Email ─────────────────────────────────────────────────────────────────────
# "console" writes the message to the logs — fine for a trial, useless for
# real users, because nobody can confirm an address or reset a password.
# Switch to smtp before you let strangers sign up.
EMAIL_BACKEND=console
EMAIL_FROM=Ignite Academy <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Set false only if you are seeding accounts yourself and mail is not wired
# up yet. Leaving it false on a public signup form means anyone can create
# an account on someone else's address.
REQUIRE_EMAIL_VERIFICATION=true

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Leave both blank and the app runs with every lesson open — which is what
# local development and a free pilot want. Setting one without the other is
# refused at boot: an unverifiable webhook would let anyone POST themselves
# a subscription.
#
# Card details never reach this server. Checkout and the Customer Portal are
# pages on Stripe's own domain; we store customer and subscription ids only.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. This signature IS the webhook endpoint's authentication.
STRIPE_WEBHOOK_SECRET=

# Price LOOKUP KEYS, not price ids. A lookup key survives you creating a new
# price for a rate change, so a price rise is a dashboard task, not a deploy.
STRIPE_PRICE_FAMILY=family_monthly
STRIPE_PRICE_ORG_SEAT=org_seat_monthly
STRIPE_TRIAL_DAYS=14

# How long access survives an unpaid bill. Cards fail and get fixed in days;
# a school paying a net-30 invoice through a purchase order routinely takes
# longer than the terms, and cutting a classroom off mid-term over an invoice
# sitting in someone's approval queue is the wrong trade.
GRACE_DAYS_CARD=14
GRACE_DAYS_INVOICE=45
INVOICE_DUE_DAYS=30

# ── Legal pages ───────────────────────────────────────────────────────────────
# Signup requires ticking "I agree to the terms", and /legal/terms and
# /legal/privacy are the pages behind it. They are built from the Markdown in
# game/content/legal/ with these values substituted in.
#
# APP_ENV=production REFUSES TO BOOT until LEGAL_ENTITY, LEGAL_EMAIL and
# LEGAL_JURISDICTION are set — otherwise the pages your customers agree to
# would say [YOUR COMPANY NAME]. See docs/LEGAL.md.

# The legal entity behind the service, exactly as it should appear.
LEGAL_ENTITY=
# Where privacy requests, deletion requests and complaints go.
LEGAL_EMAIL=
# Postal address for the same. Optional but expected in most jurisdictions.
LEGAL_ADDRESS=
# Whose law governs, e.g. "the State of Ohio, USA".
LEGAL_JURISDICTION=
# The date the current wording took effect, e.g. "1 September 2026".
LEGAL_EFFECTIVE=

# Set to true ONLY once a lawyer has actually read the pages. Until then
# every legal page carries a visible "not yet reviewed" banner and the app
# says so on every production boot. The text that ships is boilerplate,
# written to describe how this software really behaves — a starting point
# for review, not legal advice.
LEGAL_REVIEWED=false

# ── Optional ──────────────────────────────────────────────────────────────────
# Amazon storefront for physical goods. Amazon runs its own checkout, so this
# is a link and nothing more — it never touches this app or its PCI scope.
STORE_URL=

# Serve /static from a CDN origin. Leave empty and nginx serves it.
CDN_URL=

LOG_LEVEL=INFO

# ── Tuning ────────────────────────────────────────────────────────────────────
# All of these have working defaults and none needs setting to run the stack.
# They are listed because a setting you cannot find is a setting you end up
# hardcoding. Uncomment to change one; the value shown is the default.

# Students attest to being at least this old at signup. Below 13 US COPPA
# applies and this app has no verifiable-parental-consent flow, so lowering
# it does not make you compliant — see docs/LEGAL.md.
#MIN_AGE=13

# Life of a verification or password-reset link, in hours.
#TOKEN_HOURS=24
# How long a session cookie lasts, in days.
#SESSION_DAYS=14

# Rate limiting. RL_WINDOW is the window in seconds; the rest are how many
# attempts that window allows. Raise RL_SIGNUP_IP if a whole school shares
# one outbound address and teachers are enrolling classes from it.
#RL_WINDOW=900
#RL_LOGIN_USER=10
#RL_LOGIN_IP=30
#RL_SIGNUP_IP=10
#RL_RESET_IP=10

# STARTTLS on the SMTP connection. Leave on unless your relay refuses it.
#SMTP_STARTTLS=true

# Connection pool per worker. Postgres needs max_connections comfortably
# above WEB_CONCURRENCY * DB_POOL_MAX.
#DB_POOL_MIN=1
#DB_TIMEOUT=10
# Seconds to wait for the database at boot before giving up on migrations.
#DB_BOOT_RETRY=30

# Cache-Control max-age on /static, in seconds. Default is 30 days.
#STATIC_MAX_AGE=2592000

# One JSON object per line instead of readable text. On by default in
# production, where a log aggregator is reading it rather than a person.
#LOG_JSON=false
