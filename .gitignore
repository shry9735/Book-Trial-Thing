# ── Qdrant ──────────────────────────────────────────────────────────────────────
# Derived data — rebuilt from EPUBs via `python ingest.py`.  Never commit.
qdrant_storage/

# Ingest manifest tracks which EPUBs have been indexed on this machine.
# Not committed because the Qdrant index itself isn't committed.
.ingest_manifest.json

# ── Webserver ────────────────────────────────────────────────────────────────────
webserver/config.json

# ── Game ─────────────────────────────────────────────────────────────────────────
# Runtime state now lives in Postgres, not on disk. These are leftovers from
# the JSON store — kept ignored so an old checkout does not commit them, and
# so migrate_json.py has something to read on a box being upgraded.
# data/items.json and data/classroom.json are content, and stay committed.
game/data/users.json
game/data/groups.json
game/data/progress.json
game/data/assignments.json
game/data/secret_key

# ── Deployment ───────────────────────────────────────────────────────────────────
# Secrets and anything derived from them.
.env
.env.*
!.env.example
# Certificates and dumps are secrets; the directories themselves are not,
# and docker-compose mounts them, so keep the placeholders.
deploy/certs/*
!deploy/certs/.gitkeep
backups/*
!backups/.gitkeep

# Drop zone for python game/import_assets.py — sorted files move out of here,
# so anything left behind is unsorted and shouldn't be committed by accident.
game/static/art/inbox/*
!game/static/art/inbox/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/

# ── OS ───────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
