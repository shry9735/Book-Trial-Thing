# Shared proxy headers.
#
# X-Forwarded-For is set to $remote_addr — not appended to whatever the
# client sent. The app reads the last entry and trusts exactly
# TRUSTED_PROXIES hops; if this appended instead, a client could prepend a
# fake address and pick its own rate-limit bucket.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

proxy_http_version 1.1;
proxy_set_header Connection "";

proxy_connect_timeout 5s;
proxy_send_timeout    30s;
proxy_read_timeout    30s;

# Buffer the client, not the worker.
proxy_buffering    on;
proxy_request_buffering on;
